{
	"name": "@tasteee/sounds",
	"version": "0.1.0",
	"description": "A Splendid Grand Piano with a tiny API: piano.play('C4'). Wraps smplr and the Web Audio setup.",
	"type": "module",
	"license": "MIT",
	"author": "tasteee",
	"files": ["dist", "README.md"],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
			"require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
		}
	},
	"repository": { "type": "git", "url": "git+https://github.com/tasteee/sounds.git" },
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"peerDependencies": {
		"smplr": "^1.1.0"
	},
	"devDependencies": {
		"smplr": "^1.1.0",
		"tsdown": "^0.23.5",
		"typescript": "^5.9.3"
	}
}
